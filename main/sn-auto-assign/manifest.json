{
  "manifest_version": 3,
  "name": "ServiceNow Auto-Assign",
  "version": "3.0",
  "description": "Watches your GiGi queue list and auto-assigns new tickets to you using the page's own g_form/g_user, no REST API needed.",
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "host_permissions": ["https://gsk.service-now.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gsk.service-now.com/*"],
      "js": ["constants.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ServiceNow Auto-Assign"
  }
}
